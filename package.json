{
  "name": "@local/dsh-provider-usage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Left-sidebar page listing each configured model provider with its account balance and token-plan windows.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "provider",
    "quota",
    "balance"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "test": "node test/providers.test.mjs && node test/account.test.mjs && node test/merge.test.mjs && node test/client.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
